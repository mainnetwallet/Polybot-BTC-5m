POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=


POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=


API_TOKEN=



QUICK_TUNNEL=1
GIST_TOKEN=
GIST_ID=


ADMIN_USERNAME=admin
ADMIN_PASSWORD=






# ---------------------------------------------------------------------------
# Polymarket BTC market bot — copy to .env (setup.bat does this for you)
# ---------------------------------------------------------------------------

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared secret for the control API. Leave empty on 127.0.0.1; REQUIRED if HOST is not loopback.
# Clients send it as X-API-Key (or Authorization: Bearer); the WebSocket uses ?token=.

# Android app + remote access (optional, see README "Android app and remote access").
# QUICK_TUNNEL=1 starts a free Cloudflare quick tunnel next to the server and publishes its (changing) link
# to a secret GitHub Gist, so the app only needs "gist:<id>" + API_TOKEN. Requires a non-empty API_TOKEN
# and HOST=127.0.0.1. GIST_TOKEN = classic GitHub token with ONLY the "gist" scope. GIST_ID is filled in
# automatically on the first run.

# Dashboard login. Username defaults to "admin"; set your own long, unique password here.
# Log in once per browser: the session stays valid for AUTH_SESSION_DAYS and survives restarts.
# Empty ADMIN_PASSWORD = login disabled (fine on 127.0.0.1 only). Changing the password logs every browser out.
# Set one before you use QUICK_TUNNEL or bind HOST to anything but 127.0.0.1.

# Optional extra secret mixed into the session signature (leave empty if unsure)
AUTH_SECRET=
AUTH_SESSION_DAYS=365
LOG_LEVEL=INFO

# Database (absolute or relative; relative resolves against the repo root)
DATABASE_URL=sqlite:///data/polymarket_bot.db

# Strategy defaults — the stage 1 and trigger are configurable
# (the old name TRIGGER_THRESHOLD is still accepted)
STAGE1_THRESHOLD=0.85
# Once either side's best ask reaches this inside the stage 1 window without a stage 1 buy, stage 1 stops buying in that market (default 0.99).
STAGE1_BLOCK_ASK=0.99
# (the old name FINAL_WINDOW_SECONDS is still accepted)
STAGE1_SECONDS=90
# Per-stage master switches. false = that stage does nothing: no buys, no take-profit, no stop-loss.
STAGE1_ENABLED=true
STAGE2_ENABLED=true
STAGE3_ENABLED=true
# Add-on entries: one more buy per stage when this many seconds (or fewer) remain
# and a best ask is at or above the stage threshold
STAGE2_SECONDS=50
STAGE2_THRESHOLD=0.88
# Once either side's best ask reaches this inside the stage 2 window, stage 2 stops buying in that market (default 0.99).
STAGE2_BLOCK_ASK=0.99
STAGE3_SECONDS=30
STAGE3_THRESHOLD=0.90
# Once either side's best ask reaches this inside the stage 3 window, stage 3 stops buying in that market (default 0.99).
STAGE3_BLOCK_ASK=0.99
# Must be <= 1 - tick size (0.99 for the usual 0.01 tick); higher caps are clamped at order time
MAX_EXECUTION_PRICE=0.98
# Stage 1 never buys when the best ask is above this (0.97 = 97 cents)
STAGE1_MAX_ASK=0.97
# Stage 2 never buys when the best ask is above this (0.97: buys at 0.97, not at 0.98 or more).
# STAGE2_SELL_PRICE must stay at least 0.01 above it.
STAGE2_MAX_ASK=0.97
# Stage 2 does not buy when best ask - best bid is wider than this (0 = off)
STAGE2_MAX_SPREAD=0.05
# Stage 3 never buys when the best ask is above this (0.98: buys up to and including 0.98)
STAGE3_MAX_ASK=0.98
# Stage 3 does not buy when best ask - best bid is wider than this (0 = off)
STAGE3_MAX_SPREAD=0.05
# Stage 3 does not buy unless the best bid is at least this far above the stop-loss level that applies right now
# (the stop tightens to 3 % / 2 % in the last seconds). 0 = off.
STAGE3_MIN_STOP_HEADROOM=0.01
# Price-to-beat filter (USD): buy UP only if BTC >= price to beat + gap, DOWN only if BTC <= price to beat - gap.
# 0 disables it. While enabled, missing/stale BTC price data blocks buys (see BTC_PRICE_ENABLED).
MIN_PRICE_GAP_USD=35
STAGE2_MIN_PRICE_GAP_USD=30
STAGE3_MIN_PRICE_GAP_USD=25
# Stage 0: early buy + take-profit sell, independent of stages 1-3. From STAGE0_START_SECONDS left until
# STAGE0_END_SECONDS left (independent of the stage 1), buy a side whose best ask is between STAGE0_MIN_ASK and STAGE0_MAX_ASK while BTC is >= STAGE0_MIN_PRICE_GAP_USD
# beyond the price to beat in that direction; sell once the best bid is the tier's take-profit percentage above the buy price.
STAGE0_ENABLED=true
STAGE0_START_SECONDS=160
STAGE0_END_SECONDS=100
STAGE0_MIN_ASK=0.70
# Max ask for the EARLIER (cheaper) buy: asks below STAGE0_HIGH_BUY_PRICE. STAGE0_MAX_ASK below is the max ask for the
# EXPENSIVE buy (STAGE0_HIGH_BUY_PRICE or more, after STAGE0_HIGH_BUY_AFTER_PCT). Asks in between (0.85-0.89) do not buy.
STAGE0_EARLY_MAX_ASK=0.85
STAGE0_MAX_ASK=0.96
# Once either side's best ask reaches this inside the stage 0 window, stage 0 stops buying in that market (default 0.98).
STAGE0_BLOCK_ASK=0.98
STAGE0_MIN_PRICE_GAP_USD=70
# BTC gap for the EXPENSIVE buys (ask STAGE0_HIGH_BUY_PRICE or more, 0.89-0.96); STAGE0_MIN_PRICE_GAP_USD above stays for the cheaper buys. 0 = no gap needed.
STAGE0_HIGH_MIN_PRICE_GAP_USD=60
# Stage 0 take-profit in percent above the average buy price, by what stage 0 paid per share (sell price capped at STAGE0_SELL_CAP_PRICE):
# below STAGE0_MID_FROM_ASK -> LOW %, below STAGE0_HIGH_FROM_ASK -> MID %, otherwise HIGH %. 0 = no take-profit for that tier.
# Defaults: bought below 0.80 -> +10%, 0.80-0.85 -> +7%, 0.85 or more -> +5%.
STAGE0_MID_FROM_ASK=0.80
STAGE0_HIGH_FROM_ASK=0.85
STAGE0_TAKE_PROFIT_PCT_LOW=10
STAGE0_TAKE_PROFIT_PCT_MID=7
STAGE0_TAKE_PROFIT_PCT_HIGH=5
# Highest bid the stage 0 take-profit waits for: a stage 0 position is sold once the best bid reaches
# min(cost * (1 + pct / 100), STAGE0_SELL_CAP_PRICE). 0.98 = every stage 0 position is sold at the latest at a bid of 0.98.
# Keep it above STAGE0_MAX_ASK. Also editable in Settings -> Stage 0 -> Exits: take-profit.
STAGE0_SELL_CAP_PRICE=0.98
# Stage 1 take-profit: stage 1 shares that cost up to STAGE1_SELL_MAX_BUY per share are sold again as soon as the
# best bid is STAGE1_TAKE_PROFIT_PCT percent above what they cost (0 = no take-profit for them);
# shares that cost more are sold at STAGE1_SELL_PRICE_HIGH
STAGE1_SELL_ENABLED=true
STAGE1_SELL_MAX_BUY=0.88
STAGE1_TAKE_PROFIT_PCT=8
STAGE1_SELL_PRICE_HIGH=0.98
# Stage 2 take-profit: stage 2 shares are sold again as soon as the best bid reaches STAGE2_SELL_PRICE
STAGE2_SELL_ENABLED=true
STAGE2_SELL_PRICE=0.98
# Stop-loss per stage, in percent below the average price paid per share. When the best bid is at or below
# cost * (1 - pct/100), that stage's own shares are sold at the market. 0 = off for that stage.
# Example: stage 0 bought at 0.70 with 40 -> sold once the best bid is 0.42 or lower.
STAGE0_STOP_LOSS_PCT=70
STAGE1_STOP_LOSS_PCT=18
STAGE2_STOP_LOSS_PCT=10
STAGE3_STOP_LOSS_PCT=5
# Stage 0 shares bought at STAGE0_HIGH_BUY_PRICE or more use this tighter stop-loss instead of
# STAGE0_STOP_LOSS_PCT. 0 = off. Stage 0 only buys up to STAGE0_EARLY_MAX_ASK (0.85, cheaper buys) / STAGE0_MAX_ASK (0.96, expensive buys).
STAGE0_HIGH_BUY_PRICE=0.89
STAGE0_HIGH_BUY_STOP_LOSS_PCT=20
# Last seconds: with STAGE3_LAST_SECONDS or fewer seconds left, stage 3 shares use this stop-loss % instead of STAGE3_STOP_LOSS_PCT. 0 = off.
# Middle tier: with STAGE3_MID_SECONDS or fewer seconds left (and more than STAGE3_LAST_SECONDS) stage 3 uses this %. 0 = off.
STAGE3_MID_SECONDS=20
STAGE3_MID_STOP_LOSS_PCT=3
STAGE3_LAST_SECONDS=10
STAGE3_LAST_SECONDS_STOP_LOSS_PCT=2
# Buys at STAGE0_HIGH_BUY_PRICE or more only start once this percent of the stage 0 window (START -> END) has passed:
# 50 with 160 -> 100 = from 130s left. 0 = the whole window. Cheaper buys can happen the whole window.
STAGE0_HIGH_BUY_AFTER_PCT=50
TRADE_AMOUNT_USDC=50
STALE_DATA_MAX_AGE_MS=2000
MAX_OPEN_POSITIONS=1
# one_per_market | one_per_side | allow
DUPLICATE_POLICY=one_per_market
# up_first | down_first | highest_ask | block_both
CONFLICT_POLICY=up_first

# Risk
MAX_DAILY_LOSS=5.0
DAILY_PROFIT_TARGET=10.0
# false = the two limits above count REALIZED pnl only; true = realized + unrealized (floating) pnl
DAILY_LIMIT_INCLUDE_UNREALIZED=false
MAX_TRADES_PER_DAY=600

# Paper trading
PAPER_STARTING_BALANCE=100.0
PAPER_FILL_RATIO=1.0
PAPER_SLIPPAGE_BPS=0
# Taker fee = shares * rate * (p * (1-p))^exponent. Crypto taker rate is 0.07, exponent 1 per docs.polymarket.com/trading/fees.
# Live fills use the market's own fee parameters from the CLOB; these two values are the paper rate and the live fallback.
PAPER_FEE_RATE=0.07
PAPER_FEE_EXPONENT=1.0

# Live trading — ENABLED in this example file (owner decision). Set LIVE_TRADING_ENABLED=false to stay paper-only.
# A real order still needs wallet credentials, the dashboard mode switch and the confirmation phrase (see README "Live trading").
LIVE_TRADING_ENABLED=true
LIVE_CONFIRMATION_PHRASE=GO LIVE
# true = the operator confirms Polymarket is allowed in their jurisdiction.
POLYMARKET_GEO_VERIFIED=true
# Winning tokens turn into pUSD only after REDEEM (official docs: trading/positions/manage).
# true = bot redeems resolved winning positions itself (needs `pip install polymarket-client`).
# With a Relayer API key (polymarket.com > Settings > API Keys) redemption is gasless;
# without one it is an EOA transaction that needs a little POL for gas.
LIVE_AUTO_REDEEM=true


# Wallet credentials (LIVE only; never exposed by the API). CLOB V2 uses pUSD collateral.

# 0 = EOA, 1 = email/magic proxy, 2 = browser proxy, 3 = smart-contract / deposit wallet
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_CHAIN_ID=137


# Polymarket endpoints (defaults are correct)
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
DATA_API_BASE_URL=https://data-api.polymarket.com
# Relay Worker for the live BUY order POST only. Take-profit / stop-loss sells and everything else are direct.
# true  = every buy goes through ORDER_PROXY_URL, no direct fallback (relay down = buy refused and retried)
# false = buys go direct to Polymarket
ORDER_PROXY_ENABLED=false
ORDER_PROXY_URL=https://polybot.akramhossain5010.workers.dev
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
SERIES_SLUG=btc-up-or-down-5m
EVENT_SLUG_PREFIX=btc-updown-5m

# Runtime loops (discovery only; execution is websocket event-driven)
DISCOVERY_REFRESH_SECONDS=3
RESOLUTION_POLL_SECONDS=5
# Seconds between websocket keep-alive pings
WS_HEARTBEAT_SECONDS=10
# Minimum milliseconds between two persisted price ticks per market (dashboard history)
WS_PRICE_PERSIST_INTERVAL_MS=500

# Order retries
# A FOK entry that did not fill leaves nothing on the book, so it is retried almost at once:
# at most ENTRY_MAX_ATTEMPTS tries per stage and market, ENTRY_RETRY_GAP_MS apart.
ENTRY_MAX_ATTEMPTS=15
ENTRY_RETRY_GAP_MS=250
# Stage 0 has a ~60 s window, so it gets its own, larger cap (240 x 250 ms = the whole window).
STAGE0_ENTRY_MAX_ATTEMPTS=240
# Gap between two sell attempts of the same exit (take-profit / stop-loss) when the previous FOK sell did not fill
EXIT_RETRY_GAP_MS=50

# BTC price feed (Chainlink 60-second TWAP, the series Polymarket settles on).
# BTC_PRICE_ENABLED=false turns the feed off; while a price-gap filter is above 0, buys are blocked without BTC data.
BTC_PRICE_ENABLED=true
RTDS_WS_URL=wss://ws-live-data.polymarket.com
# User-Agent sent on HTTP requests to Polymarket (leave unset for the built-in browser-like default)
# HTTP_USER_AGENT=
