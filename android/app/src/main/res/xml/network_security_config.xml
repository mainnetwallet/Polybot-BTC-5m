<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed only because LAN use (http://192.168.x.x:8000) needs it.
     The app shows a warning banner for plain http outside private ranges. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
