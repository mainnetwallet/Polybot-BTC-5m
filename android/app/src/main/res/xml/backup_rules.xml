<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6-11 backup rules (the Android 12+ equivalent is data_extraction_rules.xml). The app keeps the PC address
  and the encrypted access token in its DataStore, and none of it should leave the phone: nothing is backed up.
  (android:allowBackup="false" already disables backup; this file only satisfies the lint check and stays safe if
  allowBackup is ever switched on.)
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
